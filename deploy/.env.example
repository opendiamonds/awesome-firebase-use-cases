# Cloud-360 deploy-time environment (192.168.10.10).
#
# Copy to deploy/.env on the target host, or let .github/workflows/deploy.yml
# generate it from GitHub Actions secrets. Never commit the filled-in file —
# scripts/validate_repo_contract.py rejects committed credentials.

# --- Database -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cloud360

# --- Backend ------------------------------------------------------------
# JWT signing key. Generate with: openssl rand -hex 32
JWT_SECRET=change_me

# A1 design agent — Anthropic Agent SDK routed through OpenRouter.
OPENROUTER_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-4.6
LLM_MODEL=anthropic/claude-sonnet-4.6

# n8n webhook that serves the dynamic architecture icons.
N8N_WEBHOOK_URL=

APP_ENV=staging

# --- Public surface -----------------------------------------------------
# Baked into the frontend bundle at build time (Vite inlines env), and used
# as the backend's CORS allowlist.
PUBLIC_URL=https://cloud360.danniel.cc

# Host port for the frontend nginx. Internal debugging only — the public path
# is the Cloudflare tunnel, which reaches nginx over the compose network.
FRONTEND_HOST_PORT=8090

# --- Cloudflare tunnel --------------------------------------------------
# Credentials JSON written by `cloudflared tunnel create cloud-360` on the host.
CLOUDFLARED_CREDENTIALS_FILE=/home/danniel-c/.cloudflared/b460a579-9e0d-42f1-a31d-c84d35bef065.json

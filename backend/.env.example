# Cloud-360 LOCAL DEVELOPMENT environment for the backend.
#
# SCOPE: this file configures a bare-metal `uvicorn main:app` run on your own
# machine, and nothing else. The deployment stack does NOT read it -- deploys
# are configured by deploy/.env (template: deploy/.env.example, rendered by
# deploy/render-env.sh). Keeping the two apart is enforced by
# scripts/validate_env_contract.py.
#
#   cp backend/.env.example backend/.env    then fill in the values below
#
# backend/.env is gitignored, and that is the only thing keeping secrets out of
# the repository -- the contract secret-scanner cannot see backend/. Put keys
# here and nowhere else. Full walkthrough: LOCAL-DEV.md.

# --- LLM (A1 design agent, A3 review suggestions) -----------------------
# OpenRouter API Key（A1 Design Agent 經 Anthropic Agent SDK 走 OpenRouter）
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic Agent SDK × OpenRouter（官方社群接法）
# https://openrouter.ai/docs/guides/community/anthropic-agent-sdk
ANTHROPIC_BASE_URL=https://openrouter.ai/api
# 啟動時可由 OPENROUTER_API_KEY 自動映射；也可手動填入
ANTHROPIC_AUTH_TOKEN=
# 必須顯式為空，避免 SDK 走 Anthropic 直連
ANTHROPIC_API_KEY=

# Model slug on OpenRouter
ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-4.6
LLM_MODEL=anthropic/claude-sonnet-4.6

# 可選：A3 評核建議改用較快的模型；未設定時沿用 LLM_MODEL
# REVIEW_LLM_MODEL=anthropic/claude-haiku-4.5

# Agent SDK 輸出 token 上限（OpenRouter 餘額不足時可降低，預設 12000；對應 CLAUDE_CODE_MAX_OUTPUT_TOKENS）
LLM_MAX_OUTPUT_TOKENS=12000
# 送入 LLM 的架構 XML 字元上限（預設 32000）
LLM_XML_CONTEXT_MAX_CHARS=32000

# --- n8n（動態架構圖 icons）---------------------------------------------
# N8N_WEBHOOK URL 空白時走灰底佔位圖；帳密任一為空則不送 Basic Auth header，
# webhook 會回非 200，同樣落到灰底佔位圖（服務不會壞，但也不會有人通知你）。
# Example: https://your-n8n-instance.com/webhook/get-icon
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
N8N_USER=
N8N_PASSWORD=

# --- Runtime ------------------------------------------------------------
# Application Environment (local, staging, test)
APP_ENV=local

# 本機 PostgreSQL。用 docker 起一顆的指令見 LOCAL-DEV.md §2。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud360

# JWT 簽章金鑰。未設定時 auth.py 會退回這個公開在 repo 裡的預設值，
# 本機無妨，但別把同一個值帶去任何對外環境。
JWT_SECRET=cloud360_secret_key_change_me_in_production

# 允許的前端來源（CORS，逗號分隔）。這裡放的是本機 vite dev server 的位址；
# 部署環境的來源由 deploy/.env 的 PUBLIC_URL 決定，不要混寫在這裡。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Claude API Key (Required for Anthropic native API)
ANTHROPIC_API_KEY=your_claude_api_key_here

# OpenRouter API Key (Optional, use this instead of Anthropic native API if preferred)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (Optional)
# If using Anthropic API, default is: claude-3-5-sonnet-20241022
# If using OpenRouter API, default is: anthropic/claude-3.5-sonnet
LLM_MODEL=anthropic/claude-3.5-sonnet

# n8n Webhook URL (Required for fetching dynamic SVG icons)
# Example: https://your-n8n-instance.com/webhook/get-icon
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
